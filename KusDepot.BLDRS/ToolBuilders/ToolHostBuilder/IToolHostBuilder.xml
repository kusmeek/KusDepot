<?xml version = "1.0" encoding = "utf-8" ?>

<IToolHostBuilder>

    <interface name = "IToolHostBuilder">

        <main>

            <summary>ToolHostBuilder Interface.</summary>

            <remarks>This interface defines the operational contracts of the ToolHostBuilder.</remarks>

        </main>

        <method name = "BuildHost">

            <summary>Build the ToolHost.</summary>

            <returns Cref = "IToolHost">ToolHost.</returns>

        </method>

        <method name = "BuildHostAsync">

            <summary>Build the ToolHost Async.</summary>

            <param name = "cancel" Cref = "CancellationToken">Cancellation Token.</param>

            <returns Cref = "Task{IToolHost}">ToolHost.</returns>

        </method>

        <method name = "BuildHostOpen">

            <summary>Build the ToolHost.</summary>

            <typeparam name = "TToolHost">A Type of ToolHost.</typeparam>

            <returns Cref = "IToolHost">ToolHost of type specified.</returns>

        </method>

        <method name = "BuildHostAsyncOpen">

            <summary>Build the ToolHost Async.</summary>

            <typeparam name = "TToolHost">A Type of ToolHost.</typeparam>

            <param name = "cancel" Cref = "CancellationToken">Cancellation Token.</param>

            <returns Cref = "Task{TToolHost}">ToolHost of type specified.</returns>

        </method>

        <method name = "BuildHostOpenFactory">

            <summary>Build the ToolHost using a factory delegate.</summary>

            <typeparam name = "TToolHost">A Type of ToolHost.</typeparam>

            <param name = "factory" Cref = "ToolHostFactory{TToolHost}">Factory delegate that constructs the ToolHost.</param>

            <returns Cref = "IToolHost">ToolHost of type specified.</returns>

        </method>

        <method name = "BuildHostAsyncOpenFactory">

            <summary>Build the ToolHost Async using a factory delegate.</summary>

            <typeparam name = "TToolHost">A Type of ToolHost.</typeparam>

            <param name = "factory" Cref = "ToolHostFactory{TToolHost}">Factory delegate that constructs the ToolHost.</param>

            <param name = "cancel" Cref = "CancellationToken">Cancellation Token.</param>

            <returns Cref = "Task{IToolHost}">ToolHost of type specified.</returns>

        </method>

        <method name = "ConfigureToolHost">

            <summary>Configure ToolHost.</summary>

            <param name = "action" Cref = "Action{ToolBuilderContext,IToolHost}">Configuration Action.</param>

            <remarks>Applies configuration to the built <see cref="IToolHost"/> instance after construction.</remarks>

            <returns Cref = "IToolHostBuilder">ToolHostBuilder.</returns>

        </method>

        <method name = "ConfigureToolHostAsync">

            <summary>Configure ToolHost Async.</summary>

            <param name = "action" Cref = "Func{ToolBuilderContext,IToolHost,CancellationToken,Task}">Async configuration action for the built ToolHost.</param>

            <remarks>Applies configuration to the built <see cref="IToolHost"/> instance after construction while preserving ordered execution with synchronous ToolHost-configuration actions.</remarks>

            <returns Cref = "IToolHostBuilder">ToolHostBuilder.</returns>

        </method>

        <method name = "UseConsoleLifetime">

            <summary>Use console lifetime behavior with the builder-owned Tool service provider.</summary>

            <remarks>When an external Tool service provider is supplied, the builder uses the host's default lifetime instead.</remarks>

            <returns Cref = "IToolHostBuilder">ToolHostBuilder.</returns>

        </method>

    </interface>

</IToolHostBuilder>
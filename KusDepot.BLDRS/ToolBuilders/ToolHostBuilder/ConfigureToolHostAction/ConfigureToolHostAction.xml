<?xml version = "1.0" encoding = "utf-8" ?>

<ConfigureToolHostAction>

	<class name = "ConfigureToolHostAction">

		<main>

			<summary>Represents one ordered ToolHost configuration step.</summary>

			<remarks>Wraps either a synchronous or asynchronous ToolHost configuration delegate.</remarks>

		</main>

		<property name = "Action">

			<summary>Synchronous ToolHost configuration delegate.</summary>

			<returns Cref = "Action{ToolBuilderContext,IToolHost}?">Synchronous configuration delegate.</returns>

		</property>

		<property name = "AsyncAction">

			<summary>Asynchronous ToolHost configuration delegate.</summary>

			<returns Cref = "Func{ToolBuilderContext,IToolHost,CancellationToken,Task}?">Asynchronous configuration delegate.</returns>

		</property>

		<constructor name = "ActionConstructor">

			<summary>Create a configuration step from a synchronous ToolHost configuration delegate.</summary>

			<param name = "action" Cref = "Action{ToolBuilderContext,IToolHost}">Synchronous configuration delegate.</param>

			<returns Cref = "ConfigureToolHostAction">New configuration step.</returns>

		</constructor>

		<constructor name = "AsyncActionConstructor">

			<summary>Create a configuration step from an asynchronous ToolHost configuration delegate.</summary>

			<param name = "asyncaction" Cref = "Func{ToolBuilderContext,IToolHost,CancellationToken,Task}">Asynchronous configuration delegate.</param>

			<returns Cref = "ConfigureToolHostAction">New configuration step.</returns>

		</constructor>

		<method name = "Execute">

			<summary>Execute the configuration step synchronously.</summary>

			<param name = "context" Cref = "ToolBuilderContext">Builder context.</param>

			<param name = "toolhost" Cref = "IToolHost">Built ToolHost.</param>

		</method>

		<method name = "ExecuteAsync">

			<summary>Execute the configuration step asynchronously.</summary>

			<param name = "context" Cref = "ToolBuilderContext">Builder context.</param>

			<param name = "toolhost" Cref = "IToolHost">Built ToolHost.</param>

			<param name = "cancel" Cref = "CancellationToken">Cancellation Token.</param>

			<returns Cref = "Task">A Task that represents the asynchronous operation.</returns>

		</method>

	</class>

</ConfigureToolHostAction>

<?xml version = "1.0" encoding = "utf-8" ?>

<ConfigureToolServicesAction>

	<class name = "ConfigureToolServicesAction">

		<main>

			<summary>Represents one ordered Tool service configuration step.</summary>

			<remarks>Wraps either a synchronous or asynchronous Tool service configuration delegate.</remarks>

		</main>

		<property name = "Action">

			<summary>Synchronous Tool service configuration delegate.</summary>

			<returns Cref = "Action{ToolBuilderContext,IServiceCollection}?">Synchronous configuration delegate.</returns>

		</property>

		<property name = "AsyncAction">

			<summary>Asynchronous Tool service configuration delegate.</summary>

			<returns Cref = "Func{ToolBuilderContext,IServiceCollection,CancellationToken,Task}?">Asynchronous configuration delegate.</returns>

		</property>

		<constructor name = "ActionConstructor">

			<summary>Create a configuration step from a synchronous Tool service configuration delegate.</summary>

			<param name = "action" Cref = "Action{ToolBuilderContext,IServiceCollection}">Synchronous configuration delegate.</param>

			<returns Cref = "ConfigureToolServicesAction">New configuration step.</returns>

		</constructor>

		<constructor name = "AsyncActionConstructor">

			<summary>Create a configuration step from an asynchronous Tool service configuration delegate.</summary>

			<param name = "asyncaction" Cref = "Func{ToolBuilderContext,IServiceCollection,CancellationToken,Task}">Asynchronous configuration delegate.</param>

			<returns Cref = "ConfigureToolServicesAction">New configuration step.</returns>

		</constructor>

		<method name = "Execute">

			<summary>Execute the configuration step synchronously.</summary>

			<param name = "context" Cref = "ToolBuilderContext">Builder context.</param>

			<param name = "services" Cref = "IServiceCollection">Tool-owned service collection.</param>

		</method>

		<method name = "ExecuteAsync">

			<summary>Execute the configuration step asynchronously.</summary>

			<param name = "context" Cref = "ToolBuilderContext">Builder context.</param>

			<param name = "services" Cref = "IServiceCollection">Tool-owned service collection.</param>

			<param name = "cancel" Cref = "CancellationToken">Cancellation Token.</param>

			<returns Cref = "Task">A Task that represents the asynchronous operation.</returns>

		</method>

	</class>

</ConfigureToolServicesAction>

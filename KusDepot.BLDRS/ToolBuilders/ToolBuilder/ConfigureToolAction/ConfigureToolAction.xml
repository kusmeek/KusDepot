<?xml version = "1.0" encoding = "utf-8" ?>

<ConfigureToolAction>

	<class name = "ConfigureToolAction">

		<main>

			<summary>Represents one ordered Tool configuration step.</summary>

			<remarks>Wraps either a synchronous or asynchronous Tool configuration delegate.</remarks>

		</main>

		<property name = "Action">

			<summary>Synchronous Tool configuration delegate.</summary>

			<returns Cref = "Action{ToolBuilderContext,ITool}?">Synchronous configuration delegate.</returns>

		</property>

		<property name = "AsyncAction">

			<summary>Asynchronous Tool configuration delegate.</summary>

			<returns Cref = "Func{ToolBuilderContext,ITool,CancellationToken,Task}?">Asynchronous configuration delegate.</returns>

		</property>

		<constructor name = "ActionConstructor">

			<summary>Create a configuration step from a synchronous Tool configuration delegate.</summary>

			<param name = "action" Cref = "Action{ToolBuilderContext,ITool}">Synchronous configuration delegate.</param>

			<returns Cref = "ConfigureToolAction">New configuration step.</returns>

		</constructor>

		<constructor name = "AsyncActionConstructor">

			<summary>Create a configuration step from an asynchronous Tool configuration delegate.</summary>

			<param name = "asyncaction" Cref = "Func{ToolBuilderContext,ITool,CancellationToken,Task}">Asynchronous configuration delegate.</param>

			<returns Cref = "ConfigureToolAction">New configuration step.</returns>

		</constructor>

		<method name = "Execute">

			<summary>Execute the configuration step synchronously.</summary>

			<param name = "context" Cref = "ToolBuilderContext">Builder context.</param>

			<param name = "tool" Cref = "ITool">Built Tool.</param>

		</method>

		<method name = "ExecuteAsync">

			<summary>Execute the configuration step asynchronously.</summary>

			<param name = "context" Cref = "ToolBuilderContext">Builder context.</param>

			<param name = "tool" Cref = "ITool">Built Tool.</param>

			<param name = "cancel" Cref = "CancellationToken">Cancellation Token.</param>

			<returns Cref = "Task">A Task that represents the asynchronous operation.</returns>

		</method>

	</class>

</ConfigureToolAction>

<?xml version = "1.0" encoding = "utf-8" ?>

<IToolWebHostBuilder>

    <interface name = "IToolWebHostBuilder">

        <main>

            <summary>ToolWebHostBuilder Interface.</summary>

            <remarks>This interface defines the operational contracts of the ToolWebHostBuilder.</remarks>

        </main>

        <property name = "Builder">

            <summary>WebApplication Builder</summary>

            <remarks>The managed <see cref="WebApplicationBuilder"/> for ASP.NET Core application composition.</remarks>

            <returns Cref = "WebApplicationBuilder">WebApplication Builder.</returns>

        </property>

        <method name = "BuildWebHost">

            <summary>Build the Web Host.</summary>

            <param name = "app" Cref = "WebApplication?">Prebuilt, UnStarted WebApplication</param>

            <returns Cref = "IToolWebHost">Tool Web Host.</returns>

        </method>

        <method name = "BuildWebHostAsync">

            <summary>Build the ToolWebHost Async.</summary>

            <param name = "app" Cref = "WebApplication?">Web Application.</param>

            <param name = "cancel" Cref = "CancellationToken">Cancellation Token.</param>

            <returns Cref = "Task{IToolWebHost}">Tool Web Host.</returns>

        </method>

        <method name = "BuildWebHostOpen">

            <summary>Build the Web Host.</summary>

            <param name = "app" Cref = "WebApplication?">Prebuilt, UnStarted WebApplication</param>

            <typeparam name = "TToolWebHost">A Type of ToolWebHost.</typeparam>

            <returns Cref = "IToolWebHost">ToolWebHost of type specified.</returns>

        </method>

        <method name = "BuildWebHostAsyncOpen">

            <summary>Build the ToolWebHost Async.</summary>

            <typeparam name = "TToolWebHost">A Type of ToolWebHost.</typeparam>

            <param name = "app" Cref = "WebApplication?">Web Application.</param>

            <param name = "cancel" Cref = "CancellationToken">Cancellation Token.</param>

            <returns Cref = "Task{TToolWebHost}">ToolWebHost of type specified.</returns>

        </method>

        <method name = "BuildWebHostOpenFactory">

            <summary>Build the ToolWebHost using a factory delegate.</summary>

            <typeparam name = "TToolWebHost">A Type of ToolWebHost.</typeparam>

            <param name = "factory" Cref = "ToolWebHostFactory{TToolWebHost}">Factory delegate that constructs the ToolWebHost.</param>

            <param name = "app" Cref = "WebApplication?">Web Application.</param>

            <returns Cref = "IToolWebHost">ToolWebHost of type specified.</returns>

        </method>

        <method name = "BuildWebHostAsyncOpenFactory">

            <summary>Build the ToolWebHost Async using a factory delegate.</summary>

            <typeparam name = "TToolWebHost">A Type of ToolWebHost.</typeparam>

            <param name = "factory" Cref = "ToolWebHostFactory{TToolWebHost}">Factory delegate that constructs the ToolWebHost.</param>

            <param name = "app" Cref = "WebApplication?">Web Application.</param>

            <param name = "cancel" Cref = "CancellationToken">Cancellation Token.</param>

            <returns Cref = "Task{IToolWebHost}">ToolWebHost of type specified.</returns>

        </method>

        <method name = "ConfigureToolWebHost">

            <summary>Configure ToolWebHost.</summary>

            <param name = "action" Cref = "Action{ToolBuilderContext,IToolWebHost}">Configuration Action.</param>

            <remarks>Applies configuration to the built <see cref="IToolWebHost"/> instance after construction.</remarks>

            <returns Cref = "IToolWebHostBuilder">ToolWebHostBuilder.</returns>

        </method>

        <method name = "ConfigureToolWebHostAsync">

            <summary>Configure ToolWebHost Async.</summary>

            <param name = "action" Cref = "Func{ToolBuilderContext,IToolWebHost,CancellationToken,Task}">Async configuration action for the built ToolWebHost.</param>

            <remarks>Applies configuration to the built <see cref="IToolWebHost"/> instance after construction while preserving ordered execution with synchronous ToolWebHost-configuration actions.</remarks>

            <returns Cref = "IToolWebHostBuilder">ToolWebHostBuilder.</returns>

        </method>

        <method name = "ConfigureWebApplication">

            <summary>Configure WebApplication.</summary>

            <param name = "action" Cref = "Action{WebApplication}">Configuration Action.</param>

            <remarks>Multiple calls are additive. Each action executes in registration order on the built <see cref="WebApplication"/> after it has been constructed.</remarks>

            <returns Cref = "IToolWebHostBuilder">ToolWebHostBuilder.</returns>

        </method>

        <method name = "ConnectWithApplication">

            <summary>Connect the built ToolWebHost to managed application services.</summary>

            <remarks>Registers a shared <see cref="IToolConnect"/> in managed application services when a builder-owned Tool service provider is used. This registration is skipped for an externally supplied Tool service provider.</remarks>

            <returns Cref = "IToolWebHostBuilder">ToolWebHostBuilder.</returns>

        </method>

        <method name = "LinkLifetime">

            <summary>Link the Tool host lifetime to managed application services.</summary>

            <remarks>Registers the host's shared <see cref="IToolHostLifetime"/> in managed application services when a builder-owned Tool service provider is used. This registration is skipped for an externally supplied Tool service provider.</remarks>

            <returns Cref = "IToolWebHostBuilder">ToolWebHostBuilder.</returns>

        </method>

        <method name = "UseBuilderOptions">

            <summary>Use WebApplication Options.</summary>

            <param name = "options" Cref="WebApplicationOptions?">Options.</param>

            <remarks>Uses a new Empty WebApplication Builder.</remarks>

            <returns Cref = "IToolWebHostBuilder">ToolWebHostBuilder.</returns>

        </method>

        <method name = "UseSlimBuilderArgs">

            <summary>Use Slim Builder.</summary>

            <param name = "args" Cref="String[]?">Arguments.</param>

            <remarks>Uses a new Slim WebApplication Builder.</remarks>

            <returns Cref = "IToolWebHostBuilder">ToolWebHostBuilder.</returns>

        </method>

        <method name = "UseSlimBuilder">

            <summary>Use Slim Builder.</summary>

            <param name = "options" Cref="WebApplicationOptions?">Options.</param>

            <remarks>Uses a new Slim WebApplication Builder.</remarks>

            <returns Cref = "IToolWebHostBuilder">ToolWebHostBuilder.</returns>

        </method>

        <method name = "UseFullBuilderArgs">

            <summary>Use Full Builder.</summary>

            <param name = "args" Cref="String[]?">Arguments.</param>

            <remarks>Uses a new Full WebApplication Builder.</remarks>

            <returns Cref = "IToolWebHostBuilder">ToolWebHostBuilder.</returns>

        </method>

        <method name = "UseFullBuilder">

            <summary>Use Full Builder.</summary>

            <param name = "options" Cref="WebApplicationOptions?">Options.</param>

            <remarks>Uses a new Full WebApplication Builder.</remarks>

            <returns Cref = "IToolWebHostBuilder">ToolWebHostBuilder.</returns>

        </method>

        <method name = "UseConsoleLifetime">

            <summary>Use console lifetime behavior with the builder-owned Tool service provider.</summary>

            <remarks>When an external Tool service provider is supplied, the builder uses the host's default lifetime instead.</remarks>

            <returns Cref = "IToolWebHostBuilder">ToolWebHostBuilder.</returns>

        </method>

        <method name = "UseRandomLocalPorts">

            <summary>Use Random Local Ports.</summary>

            <returns Cref = "IToolWebHostBuilder">ToolWebHostBuilder.</returns>

        </method>

    </interface>

</IToolWebHostBuilder>
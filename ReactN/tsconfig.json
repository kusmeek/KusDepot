{
  "compilerOptions": {
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "noImplicitAny": false,
    "noEmitOnError": true,
    "removeComments": false,
    "sourceMap": true,
    "rootDir": "src",
    "target": "ESNext",
    "module": "commonjs",
    "lib": [
      "ESNext"
    ],
    "types": [
      "node"
    ],
    "outDir": "target"
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "target"
  ]
}

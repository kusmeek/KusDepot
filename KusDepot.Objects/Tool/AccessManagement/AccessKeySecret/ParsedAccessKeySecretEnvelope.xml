<?xml version = "1.0" encoding = "utf-8" ?>

<ParsedAccessKeySecretEnvelope>

    <struct name = "ParsedAccessKeySecretEnvelope">

        <main>

            <summary>Parsed outer access-key secret envelope.</summary>

            <remarks>
                Internal normalized outer-envelope model used by <see cref="AccessKeySecret"/> to expose signature metadata, ciphertext ranges, and canonical signed-region bytes.
            </remarks>

        </main>

        <property name = "Algorithm" Cref = "AccessKeySignatureAlgorithm">

            <summary>Parsed outer signature algorithm.</summary>

        </property>

        <property name = "CiphertextLength" Cref = "Int32">

            <summary>Parsed ciphertext byte length.</summary>

        </property>

        <property name = "CiphertextMemory" Cref = "ReadOnlyMemory{Byte}">

            <summary>Parsed ciphertext byte region.</summary>

        </property>

        <property name = "Flags" Cref = "Byte">

            <summary>Parsed outer envelope flags byte.</summary>

        </property>

        <property name = "NonceMemory" Cref = "ReadOnlyMemory{Byte}">

            <summary>Parsed AES-GCM nonce byte region.</summary>

        </property>

        <property name = "SignatureLength" Cref = "Int32">

            <summary>Parsed signature byte length.</summary>

        </property>

        <property name = "SignatureMemory" Cref = "ReadOnlyMemory{Byte}">

            <summary>Parsed signature byte region.</summary>

        </property>

        <property name = "SignerKeyIDFormat" Cref = "AccessKeySignerKeyIdFormat">

            <summary>Parsed signer key-identifier format.</summary>

        </property>

        <property name = "SignerKeyIDMemory" Cref = "ReadOnlyMemory{Byte}">

            <summary>Parsed signer key-identifier byte region.</summary>

        </property>

        <property name = "SignerAccessManagerID" Cref = "Guid">

            <summary>Parsed outer signer access-manager identifier.</summary>

        </property>

        <property name = "SignerToolID" Cref = "Guid">

            <summary>Parsed outer signer tool identifier.</summary>

        </property>

        <property name = "SignedRegionMemory" Cref = "ReadOnlyMemory{Byte}">

            <summary>Canonical signed-region bytes excluding the signature suffix.</summary>

        </property>

        <property name = "TagMemory" Cref = "ReadOnlyMemory{Byte}">

            <summary>Parsed AES-GCM authentication-tag byte region.</summary>

        </property>

        <property name = "Signed" Cref = "Boolean">

            <summary>True when the parsed outer envelope carries signature metadata; otherwise false.</summary>

        </property>

    </struct>

</ParsedAccessKeySecretEnvelope>

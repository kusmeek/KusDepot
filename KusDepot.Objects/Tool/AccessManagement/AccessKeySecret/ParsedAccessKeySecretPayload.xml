<?xml version = "1.0" encoding = "utf-8" ?>

<ParsedAccessKeySecretPayload>

    <class name = "ParsedAccessKeySecretPayload">

        <main>

            <summary>Parsed access-key secret payload.</summary>

            <remarks>
                Internal normalized decrypted payload model used by `AccessKeySecret` to project membership tokens, access-key claims, full assertions, and derived assertion summaries from a single parse result.
            </remarks>

        </main>

        <property name = "AccessKeyRealmID" Cref = "String">

            <summary>Parsed access-key realm identifier.</summary>

        </property>

        <property name = "Assertions" Cref = "ImmutableArray{AccessKeyAssertion}">

            <summary>Parsed full embedded access-key assertions.</summary>

        </property>

        <property name = "AssertionSummaries" Cref = "ImmutableArray{AccessKeyAssertionSummary}">

            <summary>Derived lightweight assertion summaries projected from the parsed assertions.</summary>

        </property>

        <property name = "Audiences" Cref = "ImmutableArray{String}">

            <summary>Parsed local audience values.</summary>

        </property>

        <property name = "IssuedAt" Cref = "DateTimeOffset">

            <summary>Parsed issuance instant.</summary>

        </property>

        <property name = "IssuerAccessManagerID" Cref = "Guid">

            <summary>Parsed issuer access-manager identifier.</summary>

        </property>

        <property name = "IssuerToolID" Cref = "Guid">

            <summary>Parsed issuer tool identifier.</summary>

        </property>

        <property name = "ManifestHash" Cref = "String">

            <summary>Parsed manifest hash.</summary>

        </property>

        <property name = "NotAfter" Cref = "DateTimeOffset?">

            <summary>Parsed expiration instant if present; otherwise null.</summary>

        </property>

        <property name = "Permissions" Cref = "Byte[]">

            <summary>Parsed permission bitmap bytes.</summary>

        </property>

        <property name = "Scopes" Cref = "ImmutableArray{String}">

            <summary>Parsed local scope values.</summary>

        </property>

        <property name = "Subject" Cref = "String">

            <summary>Parsed subject value.</summary>

        </property>

        <property name = "Token" Cref = "AccessKeyToken">

            <summary>Parsed access-key token identity.</summary>

        </property>

        <property name = "ToolSchemaID" Cref = "String">

            <summary>Parsed tool schema identifier.</summary>

        </property>

        <method name = "ToClaims">
            <summary>Project the parsed payload into access-key claims for a specific evaluation instant.</summary>
            <param name = "evaluatedat" Cref = "DateTimeOffset">UTC instant used to compute expiration state.</param>
            <returns Cref = "AccessKeyClaims">Projected access-key claims.</returns>
        </method>

        <method name = "ToMembershipToken">
            <summary>Project the parsed payload into a membership token.</summary>
            <returns Cref = "MembershipToken">Projected membership token.</returns>
        </method>

    </class>

</ParsedAccessKeySecretPayload>

<?xml version = "1.0" encoding = "utf-8" ?>

<AccessKeyToken>

    <struct name = "AccessKeyToken">

        <main>

            <summary>Opaque token identity bytes used for membership and revocation.</summary>

            <remarks>
                <list type = "bullet">
                    <item><description>Represents the explicit token identifier embedded in an access token.</description></item>
                </list>
            </remarks>

        </main>

        <constructor name = "Constructor" Cref = "AccessKeyToken">

            <summary>Create token wrapper from identity bytes.</summary>

            <param name = "bytes" Cref = "ReadOnlySpan{Byte}">Token identity bytes.</param>

        </constructor>

        <method name = "Create">

            <summary>Create token wrapper from identity bytes.</summary>

            <param name = "bytes" Cref = "ReadOnlySpan{Byte}">Token identity bytes.</param>

            <returns Cref = "AccessKeyToken">New token instance.</returns>

        </method>

        <field name = "part1" Cref = "UInt128">

            <summary>First token identity segment.</summary>

        </field>

        <field name = "part2" Cref = "UInt128">

            <summary>Second token identity segment.</summary>

        </field>

        <field name = "part3" Cref = "UInt128">

            <summary>Third token identity segment.</summary>

        </field>

        <field name = "part4" Cref = "UInt128">

            <summary>Fourth token identity segment.</summary>

        </field>

        <method name = "Clear">

            <summary>Clear token memory.</summary>

        </method>

        <method name = "Clone">

            <summary>Clone AccessKeyToken.</summary>

            <returns Cref = "AccessKeyToken">Cloned token.</returns>

        </method>

        <method name = "Equals">

            <summary>Constant-time equality comparison with another AccessKeyToken.</summary>

            <param name = "other" Cref = "AccessKeyToken">Other token.</param>

            <returns Cref = "Boolean">True if equal; otherwise false.</returns>

        </method>

        <method name = "op_Equality">

            <summary>Constant-time equality operator.</summary>

            <param name = "a" Cref = "AccessKeyToken">Left operand.</param>

            <param name = "b" Cref = "AccessKeyToken">Right operand.</param>

            <returns Cref = "Boolean">True if equal; otherwise false.</returns>

        </method>

        <method name = "op_Inequality">

            <summary>Inequality operator (negation of ==).</summary>

            <param name = "a" Cref = "AccessKeyToken">Left operand.</param>

            <param name = "b" Cref = "AccessKeyToken">Right operand.</param>

            <returns Cref = "Boolean">True if not equal; otherwise false.</returns>

        </method>

    </struct>

</AccessKeyToken>

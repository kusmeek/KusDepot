<?xml version = "1.0" encoding = "utf-8" ?>

<AccessCredential>

    <class name = "AccessCredential">

        <main>

            <summary>Presented access credential.</summary>

            <remarks>
                Base request credential type used to carry credential material such as certificates, JWTs, management keys, and opaque tokens.
            </remarks>

        </main>

        <method name = "ParseAny">

            <summary>Parse an access credential.</summary>

            <param name = "input" Cref = "String">Credential JSON.</param>

            <param name = "format" Cref = "IFormatProvider?">Format provider.</param>

            <returns Cref = "AccessCredential">Parsed access credential.</returns>

        </method>

        <method name = "Parse">

            <summary>Parse an access credential.</summary>

            <typeparam name = "TResult">Credential type to parse.</typeparam>

            <param name = "input" Cref = "String">Credential JSON.</param>

            <param name = "format" Cref = "IFormatProvider?">Format provider.</param>

            <returns Cref = "AccessCredential">Parsed access credential.</returns>

        </method>

        <method name = "TryParse">

            <summary>Try to parse an access credential.</summary>

            <typeparam name = "TResult">Credential type to parse.</typeparam>

            <param name = "input" Cref = "String">Credential JSON.</param>

            <param name = "format" Cref = "IFormatProvider?">Format provider.</param>

            <param name = "result" Cref = "TResult">Parsed access credential.</param>

            <returns Cref = "Boolean">True when parsing succeeds; otherwise false.</returns>

        </method>

    </class>

</AccessCredential>

<?xml version = "1.0" encoding = "utf-8" ?>

<CertificateCredential>

    <class name = "CertificateCredential">

        <main>

            <summary>Certificate-backed request credential.</summary>

        </main>

        <property name = "Certificate" Cref = "Byte[]">

            <summary>Serialized certificate bytes.</summary>

        </property>

        <method name = "Create">

            <summary>Create a certificate credential from an `X509Certificate2`.</summary>

            <param name = "certificate" Cref = "X509Certificate2">Certificate to serialize.</param>

            <returns Cref = "CertificateCredential">Certificate credential.</returns>

        </method>

        <method name = "TryGetCertificate">

            <summary>Try to reconstruct an `X509Certificate2` from the stored certificate bytes.</summary>

            <param name = "certificate" Cref = "X509Certificate2">Reconstructed certificate.</param>

            <returns Cref = "Boolean">True when certificate reconstruction succeeds; otherwise false.</returns>

        </method>

        <method name = "Equals">

            <summary>Determine equality.</summary>

            <param name = "other" Cref = "CertificateCredential">Other credential.</param>

            <returns Cref = "Boolean">True if equal.</returns>

        </method>

        <method name = "GetHashCode">

            <summary>Get the hash code for the credential.</summary>

            <returns Cref = "Int32">Hash code.</returns>

        </method>

    </class>

</CertificateCredential>

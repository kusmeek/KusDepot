            </remarks>

        </main>

        <property name = "AssertionType" Cref = "String">

            <summary>Semantic assertion type identifier.</summary>

        </property>

        <property name = "Format" Cref = "String">

            <summary>Assertion payload format discriminator.</summary>

        </property>

        <method name = "Copy">

            <summary>Create a copy of the access-key assertion summary.</summary>

            <returns Cref = "AccessKeyAssertionSummary">Copied access-key assertion summary.</returns>

        </method>

    </record>

</AccessKeyAssertionSummary>

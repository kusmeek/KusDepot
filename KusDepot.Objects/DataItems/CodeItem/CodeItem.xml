<?xml version = "1.0" encoding = "utf-8" ?>

<CodeItem>

    <class name = "CodeItem">

        <main>

            <summary>Source Code.</summary>

            <remarks>This item stores interpretable, compilable, or assemblable source code.</remarks>

        </main>

        <method name = "CaptureContentIntegritySnapshot_NoSync">
            <summary>Capture the CodeItem content projection used by canonical content-integrity hashing.</summary>
            <remarks>Includes in-memory code content and excludes unrelated metadata. Streamed and encrypted content continue using their existing byte-integrity paths.</remarks>
            <returns Cref = "ContentIntegritySnapshot">Captured CodeItem content projection.</returns>
        </method>

        <method name = "CaptureContentMutationMemento_NoSync">
            <summary>Capture the resident code payload needed to roll back a rejected content mutation.</summary>
            <remarks>The memento restores the prior Content value; shared protection and integrity state is restored by DataItemStateSnapshot.</remarks>
            <returns Cref = "DataItemContentMutationMemento">Memento for the current code payload.</returns>
        </method>



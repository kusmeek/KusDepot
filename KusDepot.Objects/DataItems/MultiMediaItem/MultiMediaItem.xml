<MultiMediaItem>

    <class name = "MultiMediaItem">

        <main>

            <summary>Audio | Image | Video.</summary>

            <remarks>This item wraps a live stream and/or contains media images or samples for consumption.</remarks>

        </main>

        <method name = "CaptureContentIntegritySnapshot_NoSync">
            <summary>Capture the MultiMediaItem content projection used by canonical content-integrity hashing.</summary>
            <remarks>Uses encrypted bytes when encrypted, in-memory bytes when resident, or a stream-backed value for streamed content. Media metadata is excluded.</remarks>
            <returns Cref = "ContentIntegritySnapshot">Captured MultiMediaItem content projection.</returns>
        </method>

        <method name = "CaptureContentMutationMemento_NoSync">
            <summary>Capture the resident media bytes for rollback of a rejected content update.</summary>
            <remarks>The memento restores the prior Content array reference; DataItemStateSnapshot restores shared protection and integrity state.</remarks>
            <returns Cref = "DataItemContentMutationMemento">Memento for the current media payload.</returns>
        </method>



<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="LabX02.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:LabX02"
    mc:Ignorable="d"
    Title="">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid" Padding="24" RowSpacing="20" ColumnSpacing="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Padding="20"
                    CornerRadius="16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Spacing="6">
                        
                        <TextBlock Text="Live streaming"
                                   Style="{ThemeResource BodyStrongTextBlockStyle}"
                                   Opacity="0.78" />
                        <TextBlock Text="{x:Bind ViewModel.Endpoint, Mode=OneWay}"
                                   TextWrapping="WrapWholeWords"
                                   Style="{ThemeResource BodyTextBlockStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.WorkingDirectory, Mode=OneWay}"
                                   TextWrapping="WrapWholeWords"
                                   Style="{ThemeResource BodyTextBlockStyle}"
                                   Opacity="0.78" />
                    </StackPanel>

                    <InfoBar Grid.Column="1"
                             Width="360"
                             IsOpen="True"
                             IsClosable="False"
                             Severity="Informational"
                             Title="Status"
                             Message="{x:Bind ViewModel.Status, Mode=OneWay}" />
                </Grid>
            </Border>

            <Grid Grid.Row="1" ColumnSpacing="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.2*" />
                    <ColumnDefinition Width="0.8*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Padding="20"
                        CornerRadius="16"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                    <StackPanel Spacing="16">
                        <TextBlock Text="Session"
                                   Style="{ThemeResource TitleTextBlockStyle}" />

                        <Grid ColumnSpacing="12" RowSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Mode" VerticalAlignment="Center" />
                            <TextBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" IsReadOnly="True" Text="{x:Bind ViewModel.ModeText, Mode=OneWay}" />

                            <TextBlock Grid.Row="1" Text="Item ID" VerticalAlignment="Center" />
                            <TextBox Grid.Row="1" Grid.Column="1" IsReadOnly="True" Text="{x:Bind ViewModel.ItemIdText, Mode=OneWay}" />
                            <Button Grid.Row="1" Grid.Column="2" Content="Copy" Click="CopyItemIdButton_Click" />

                            <TextBlock Grid.Row="2" Text="Session ID" VerticalAlignment="Center" />
                            <TextBox Grid.Row="2" Grid.Column="1" IsReadOnly="True" Text="{x:Bind ViewModel.SessionIdText, Mode=OneWay}" />
                            <Button Grid.Row="2" Grid.Column="2" Content="Copy" Click="CopySessionIdButton_Click" />

                            <TextBlock Grid.Row="3" Text="Bytes Produced" VerticalAlignment="Center" />
                            <TextBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" IsReadOnly="True" Text="{x:Bind ViewModel.BytesProducedText, Mode=OneWay}" />

                            <TextBlock Grid.Row="4" Text="Chunks Produced" VerticalAlignment="Center" />
                            <TextBox Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" IsReadOnly="True" Text="{x:Bind ViewModel.ChunksProducedText, Mode=OneWay}" />

                            <TextBlock Grid.Row="5" Text="Committed Summary" VerticalAlignment="Center" />
                            <TextBox Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2"
                                     IsReadOnly="True"
                                     TextWrapping="Wrap"
                                     Text="{x:Bind ViewModel.CommittedItemSummary, Mode=OneWay}" />

                            <TextBlock Grid.Row="6" Text="Status" VerticalAlignment="Center" />
                            <TextBox Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="2"
                                     IsReadOnly="True"
                                     TextWrapping="Wrap"
                                     Text="{x:Bind ViewModel.Status, Mode=OneWay}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1"
                        Padding="20"
                        CornerRadius="16"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                    <StackPanel Spacing="16">
                        <TextBlock Text="Actions"
                                   Style="{ThemeResource TitleTextBlockStyle}" />

                        <Grid ColumnSpacing="12" RowSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Button Grid.Row="0" Grid.Column="0" Content="Start" Click="StartButton_Click" />
                            <Button Grid.Row="0" Grid.Column="1"
                                    HorizontalAlignment="Right"
                                    Content="Abort"
                                    Click="AbortButton_Click" />

                            <Button Grid.Row="1" Grid.Column="0"
                                    Content="{x:Bind ViewModel.PauseButtonText, Mode=OneWay}"
                                    Click="PauseButton_Click" />
                            <Button Grid.Row="1" Grid.Column="1"
                                    HorizontalAlignment="Right"
                                    Content="{x:Bind ViewModel.RandomPauseButtonText, Mode=OneWay}"
                                    Click="RandomPauseButton_Click" />

                            <Button Grid.Row="2" Grid.Column="0" Content="Commit Final" Click="CompleteButton_Click" />
                            <StackPanel Grid.Row="2"
                                        Grid.Column="1"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        Spacing="12">
                                <Button Content="Reset" Click="ResetButton_Click" />
                                <Button Content="Close" Click="CloseButton_Click" />
                            </StackPanel>

                            <Button Grid.Row="3" Grid.Column="0"
                                    Content="Toggle Payload"
                                    IsEnabled="{x:Bind ViewModel.CanTogglePayloadMode, Mode=OneWay}"
                                    Click="TogglePayloadButton_Click" />
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Grid.Row="2" ColumnSpacing="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.05*" />
                    <ColumnDefinition Width="0.95*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Padding="20"
                        CornerRadius="16"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                    <Grid RowSpacing="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="Final Item Metadata"
                                   Grid.Row="0"
                                   Style="{ThemeResource TitleTextBlockStyle}" />

                        <ScrollViewer Grid.Row="1"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto"
                                      VerticalScrollMode="Auto">
                            <Grid ColumnSpacing="12" RowSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="Item Type" VerticalAlignment="Center" />
                                <ComboBox Grid.Row="0" Grid.Column="1"
                                          ItemsSource="{x:Bind ViewModel.FinalItemTypes, Mode=OneWay}"
                                          SelectedItem="{x:Bind ViewModel.FinalItemType, Mode=TwoWay}" />

                                <TextBlock Grid.Row="1" Text="Data Type" VerticalAlignment="Center" />
                                <Grid Grid.Row="1" Grid.Column="1">
                                    <ComboBox ItemsSource="{x:Bind ViewModel.AvailableFinalItemDataTypes, Mode=OneWay}"
                                              SelectedItem="{x:Bind ViewModel.SelectedFinalItemDataType, Mode=TwoWay}"
                                              Visibility="{x:Bind ViewModel.DataTypeComboBoxVisibility, Mode=OneWay}" />
                                    <TextBox Text="{x:Bind ViewModel.FinalItemDataTypeText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Visibility="{x:Bind ViewModel.DataTypeTextBoxVisibility, Mode=OneWay}" />
                                </Grid>

                                <TextBlock Grid.Row="2" Text="Name" VerticalAlignment="Center" />
                                <TextBox Grid.Row="2" Grid.Column="1"
                                         AcceptsReturn="False"
                                         Text="{x:Bind ViewModel.FinalItemName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Grid.Row="3" Text="Tags" VerticalAlignment="Top" Margin="0,10,0,0" />
                                <TextBox Grid.Row="3" Grid.Column="1"
                                         MinHeight="120"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         PlaceholderText="One tag per line"
                                         Text="{x:Bind ViewModel.FinalItemTagsText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Grid.Row="4" Text="Notes" VerticalAlignment="Top" Margin="0,10,0,0" />
                                <TextBox Grid.Row="4" Grid.Column="1"
                                         MinHeight="180"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         PlaceholderText="One note per line"
                                         Text="{x:Bind ViewModel.FinalItemNotesText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <Border Grid.Column="1"
                        Padding="20"
                        CornerRadius="16"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                    <StackPanel Spacing="16">
                        <TextBlock Text="Live Output"
                                   Style="{ThemeResource TitleTextBlockStyle}" />
                        <TextBox IsReadOnly="True"
                                 AcceptsReturn="True"
                                 TextWrapping="NoWrap"
                                 FontFamily="Consolas"
                                 HorizontalAlignment="Stretch"
                                 VerticalAlignment="Stretch"
                                 Height="420"
                                 Padding="10,8,10,14"
                                 Text="{x:Bind ViewModel.LogText, Mode=OneWay}" />
                    </StackPanel>
                </Border>
            </Grid>
    </Grid>
</Window>



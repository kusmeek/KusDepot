<?xml version = "1.0" encoding = "utf-8" ?>

<CommitUploadTransfer>

	<record name = "CommitUploadTransferRequest">
		<main><summary>Request final validation and publication of a fully realized staged transfer.</summary></main>
		<property name = "SessionID" Cref = "Guid"><summary>Transfer session identifier.</summary></property>
		<property name = "ItemID" Cref = "Guid"><summary>Immutable data item identifier.</summary></property>
		<property name = "ExpectedStateVersion" Cref = "Int64"><summary>Expected current state version.</summary></property>
	</record>

	<record name = "CommitUploadTransferResponse">
		<main><summary>Response describing the post-commit state of a staged transfer session.</summary></main>
		<property name = "State" Cref = "DataItemTransferState"><summary>Current transfer state.</summary></property>
		<property name = "Published" Cref = "Boolean"><summary>Whether publication succeeded.</summary></property>
	</record>

</CommitUploadTransfer>

<?xml version = "1.0" encoding = "utf-8" ?>

<OpenStreamTransfer>

	<record name = "OpenStreamTransferRequest">
		<main><summary>Request to create a new source stream-transfer session.</summary></main>
		<property name = "ItemID" Cref = "Guid"><summary>Immutable data item identifier.</summary></property>
		<property name = "ObjectInfo" Cref = "DataItemTransferObjectInfo?"><summary>Optional descriptive object summary.</summary></property>
		<property name = "ObjectPayload" Cref = "Byte[]"><summary>Optional serialized object payload used to initialize the stream-transfer session.</summary></property>
		<property name = "ObjectSHA512" Cref = "Byte[]"><summary>SHA-512 of the serialized object payload when present.</summary></property>
		<property name = "RequestedSegmentSizePolicy" Cref = "DataItemTransferSegmentSizePolicy?"><summary>Optional requested segment size guidance.</summary></property>
		<property name = "SessionID" Cref = "Guid"><summary>Requested transfer session identifier.</summary></property>
	</record>

	<record name = "OpenStreamTransferResponse">
		<main><summary>Response containing the current state of a source stream-transfer session.</summary></main>
		<property name = "State" Cref = "DataStreamTransferState"><summary>Current transfer state.</summary></property>
	</record>

</OpenStreamTransfer>

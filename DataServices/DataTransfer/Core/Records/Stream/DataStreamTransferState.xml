<?xml version = "1.0" encoding = "utf-8" ?>

<DataStreamTransferState>

	<record name = "DataStreamTransferState">
		<main><summary>State view describing the current status of an append or follow stream-transfer session.</summary></main>
		<property name = "AppendedLength" Cref = "Int64"><summary>Current durable appended length in bytes.</summary></property>
		<property name = "Created" Cref = "DateTimeOffset"><summary>Creation timestamp.</summary></property>
		<property name = "FaultMessage" Cref = "String?"><summary>Optional current fault detail.</summary></property>
		<property name = "ItemID" Cref = "Guid"><summary>Immutable data item identifier.</summary></property>
		<property name = "Mode" Cref = "DataItemTransferMode"><summary>Current transfer session mode.</summary></property>
		<property name = "ObjectInfo" Cref = "DataItemTransferObjectInfo?"><summary>Optional descriptive object summary.</summary></property>
		<property name = "ObjectSHA512" Cref = "Byte[]"><summary>SHA-512 of the serialized object payload when present.</summary></property>
		<property name = "SegmentSizePolicy" Cref = "DataItemTransferSegmentSizePolicy"><summary>Advertised segment size guidance.</summary></property>
		<property name = "SessionID" Cref = "Guid"><summary>Transfer session identifier.</summary></property>
		<property name = "SourceSessionID" Cref = "Guid?"><summary>Optional source session identifier for follower sessions.</summary></property>
		<property name = "StateVersion" Cref = "Int64"><summary>Monotonic transfer state version.</summary></property>
		<property name = "Status" Cref = "DataItemTransferStatus"><summary>Current transfer status.</summary></property>
		<property name = "StreamSHA512" Cref = "Byte[]"><summary>Optional final SHA-512 of the durable stream payload.</summary></property>
		<property name = "Updated" Cref = "DateTimeOffset"><summary>Last update timestamp.</summary></property>
	</record>

</DataStreamTransferState>

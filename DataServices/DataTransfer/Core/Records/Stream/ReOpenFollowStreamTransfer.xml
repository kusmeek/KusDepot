<?xml version = "1.0" encoding = "utf-8" ?>

<ReOpenFollowStreamTransfer>

	<record name = "ReOpenFollowStreamTransferRequest">
		<main><summary>Request to reattach to an existing follower stream-transfer session.</summary></main>
		<property name = "ItemID" Cref = "Guid"><summary>Immutable data item identifier.</summary></property>
		<property name = "SessionID" Cref = "Guid"><summary>Follower transfer session identifier.</summary></property>
		<property name = "SourceSessionID" Cref = "Guid"><summary>Source transfer session identifier.</summary></property>
	</record>

	<record name = "ReOpenFollowStreamTransferResponse">
		<main><summary>Response containing the current state of a reopened follower stream-transfer session.</summary></main>
		<property name = "ObjectPayload" Cref = "Byte[]"><summary>Serialized source object payload used to reconstruct the followed data item.</summary></property>
		<property name = "State" Cref = "DataStreamTransferState"><summary>Current transfer state.</summary></property>
	</record>

</ReOpenFollowStreamTransfer>

<?xml version = "1.0" encoding = "utf-8" ?>

<OpenFollowStreamTransfer>

	<record name = "OpenFollowStreamTransferRequest">
		<main><summary>Request to create a follower stream-transfer session over an active source session.</summary></main>
		<property name = "ItemID" Cref = "Guid"><summary>Immutable data item identifier.</summary></property>
		<property name = "SessionID" Cref = "Guid"><summary>Requested follower transfer session identifier.</summary></property>
		<property name = "SourceSessionID" Cref = "Guid"><summary>Active source stream-transfer session identifier.</summary></property>
	</record>

	<record name = "OpenFollowStreamTransferResponse">
		<main><summary>Response containing the current state of a follower stream-transfer session.</summary></main>
		<property name = "ObjectPayload" Cref = "Byte[]"><summary>Serialized source object payload used to reconstruct the followed data item.</summary></property>
		<property name = "State" Cref = "DataStreamTransferState"><summary>Current transfer state.</summary></property>
	</record>

</OpenFollowStreamTransfer>
